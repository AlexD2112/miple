PORT=8787

# Supabase (service role: server only, never ship to the app)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Gemini Enterprise Agent Platform (formerly Vertex AI) via Application Default Credentials.
# Locally: gcloud auth application-default login
#          gcloud auth application-default set-quota-project YOUR_PROJECT_ID
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
MIPLE_MODEL=gemini-2.5-flash

# Perceptron OCR (perceptron-mk1.5). Leave the key blank to fall back to Gemini vision.
# The URL defaults to https://api.perceptron.inc/v1/chat/completions
PERCEPTRON_API_KEY=
PERCEPTRON_OCR_URL=

# Photon (SMS / iMessage nudges). Leave blank for dry-run (messages are logged).
PHOTON_API_KEY=
PHOTON_SEND_URL=
PHOTON_WEBHOOK_SECRET=

# VEYZL audits: set VEYZL's Base URL to https://<host>/audit/<this value> (or send it as the bearer
# token / x-veyzl-token header). Leave blank to turn audits off; AI routes then always require a login.
VEYZL_PROBE_TOKEN=

# Daily nudge schedule (cron syntax, server local time)
NUDGE_CRON=0 9 * * *
