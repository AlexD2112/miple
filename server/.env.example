PORT=8787

# Supabase. The service-role key bypasses row-level security, so keep it on the server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Gemini on Vertex AI, authenticated with Application Default Credentials (no API key).
# On a laptop, run `gcloud auth application-default login` and
# `gcloud auth application-default set-quota-project YOUR_PROJECT_ID` first.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
RIPE_MODEL=gemini-2.5-flash
# 0 turns off Gemini's thinking step (about twice as fast); -1 lets the model decide.
GEMINI_THINKING_BUDGET=0
# Small model for the allergy and diet check that runs alongside each chef reply.
SAFETY_MODEL=gemini-2.5-flash-lite

# Perceptron OCR (Mk1.5). Without a key, Gemini reads receipt images directly.
# The URL defaults to https://api.perceptron.inc/v1/chat/completions.
PERCEPTRON_API_KEY=
PERCEPTRON_OCR_URL=

# VEYZL audits. VEYZL sends this value as its bearer token, or uses https://<host>/audit/<value>
# as its base URL. Leave it empty to require a login on every AI route.
VEYZL_PROBE_TOKEN=

# Nightly job that marks expired pantry items as wasted, in cron syntax, evaluated in EXPIRY_TIMEZONE.
EXPIRY_CRON=5 0 * * *
EXPIRY_TIMEZONE=America/Los_Angeles
