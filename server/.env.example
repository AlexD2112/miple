PORT=8787

# Supabase (service role: server only, never ship to the app)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini for receipt normalization, vision OCR fallback, recipes, and chef chat
GEMINI_API_KEY=
MIPLE_MODEL=gemini-2.5-flash

# Perceptron OCR. Leave blank to fall back to Gemini vision.
PERCEPTRON_API_KEY=
PERCEPTRON_OCR_URL=

# Photon (SMS / iMessage nudges). Leave blank for dry-run (messages are logged).
PHOTON_API_KEY=
PHOTON_SEND_URL=
PHOTON_WEBHOOK_SECRET=

# Daily nudge schedule (cron syntax, server local time)
NUDGE_CRON=0 9 * * *
